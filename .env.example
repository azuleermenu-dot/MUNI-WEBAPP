# Existing MUNI Supabase project credentials
# Never commit a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-muni-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Expo reads these public client values at build time.
EXPO_PUBLIC_SUPABASE_URL=https://your-muni-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
